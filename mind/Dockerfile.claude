# Claude Code 게이트웨이 (Claude 구독 인증)
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates jq git \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code@latest

COPY run.sh /usr/local/bin/agent-run
COPY loop.sh /usr/local/bin/agent-loop
COPY healthcheck.sh /usr/local/bin/agent-health
RUN chmod +x /usr/local/bin/agent-run /usr/local/bin/agent-loop \
      /usr/local/bin/agent-health

RUN useradd -m -u 10001 agent
USER agent
WORKDIR /work

# 인증 디렉터리. secrets/claude 를 여기에 rw 로 마운트한다.
# 맥 호스트의 ~/.claude 를 그대로 마운트하면 안 된다. README 참고.
ENV CLAUDE_CONFIG_DIR=/home/agent/.claude
ENV AGENT_CLI=claude
ENV AGENT_ROLE=reviewer
ENV AGENT_MODEL=sonnet

ENV SPOOL_DIR=/spool

# 상주 모드: 스풀 폴링. 단발 호출은 `docker run --rm -i <image> agent-run`.
CMD ["agent-loop"]
