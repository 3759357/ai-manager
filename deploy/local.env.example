# 내 PC에서 쓰는 배포 설정 예시. 복사해서 사용합니다(실제 파일은 Git에서 제외).
#   cp deploy/local.env.example deploy/local.env
# 환경변수로 같은 이름을 주면 이 파일보다 우선합니다.

# 서버 SSH 접속 대상: ~/.ssh/config의 Host 별칭 또는 user@host
AI_MANAGER_SERVER=myserver

# GitHub 공개본 저장소를 둔 로컬 폴더 (publish/export_public.py 기본 출력 위치)
AI_MANAGER_PUBLIC_DIR=../ai-manager-public
