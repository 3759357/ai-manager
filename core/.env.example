# Core
CORE_DEFAULT_BROKER=toss
CORE_MAX_QUOTE_DIVERGENCE_PCT=0.20
# 리스크 한도는 core/src/core/policy/v1.toml에서 읽습니다. 아래 값은 비워 두면 정책 그대로이고,
# 적으면 정책보다 엄격한 경우에만 반영됩니다.
CORE_MIN_CASH_PCT=
CORE_MAX_LEVERAGED_EXPOSURE_PCT=
CORE_MAX_SINGLE_POSITION_PCT=
CORE_MAX_DAILY_NEW_BUY_USD=
CORE_PANIC_BUY_BLOCK_MINUTES=30
CORE_DATABASE_PATH=data/core.db
CORE_KILL_SWITCH_PATH=data/kill-switch.json
CORE_NOTIFY_CHANNELS=console
# 레버리지 종목과 배수 (쉼표 구분, 배수를 생략하면 3배로 가정). 예: SOXL:3,MUU:2,GGLL:2
CORE_LEVERAGED_SYMBOLS=
CORE_DISCORD_WEBHOOK_URL=
CORE_DISCORD_USERNAME=ai-manager

# --- LLM 전략 심사 게이트웨이 ---
# 워커와 에이전트 컨테이너가 공유하는 스풀. 둘 사이의 유일한 통로다.
CORE_STRATEGY_SPOOL_PATH=data/spool
CORE_STRATEGY_ROLE=reviewer
# codex | claude
CORE_STRATEGY_CLI=codex
CORE_STRATEGY_MODEL=gpt-5-codex
CORE_STRATEGY_PROMPT_PATH=../mind/prompts/reviewer.md
# 프롬프트를 고치면 반드시 올린다. 안 그러면 나중에 판단을 재현할 수 없다.
CORE_STRATEGY_PROMPT_VERSION=reviewer-v1
CORE_STRATEGY_TIMEOUT_SECONDS=120
# 같은 서명의 후보를 다시 묻지 않는 기간
CORE_STRATEGY_CACHE_TTL_MINUTES=30
# 진입가가 현재가에서 이 % 이상 벌어지면 오래된 후보로 보고 차단
CORE_STRATEGY_BAND_PCT=10
# 호출 예산. 구독 사용량이 유한하므로 리스크처럼 배급한다.
CORE_STRATEGY_MAX_CALLS_PER_WINDOW=20
CORE_STRATEGY_WINDOW_HOURS=5
CORE_STRATEGY_MAX_CALLS_PER_DAY=60
CORE_STRATEGY_MIN_INTERVAL_SECONDS=30
# 평시에는 남겨두는 예비 호출 수
CORE_STRATEGY_RESERVE_CALLS=3

# KIS
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ALLOW_ORDERS=false
KIS_REAL_TRADING_ACK=
KIS_MAX_ORDER_AMOUNT=100000
KIS_MAX_OVERSEAS_ORDER_AMOUNT_USD=500
KIS_TIMEOUT_SECONDS=10
KI_DB_PATH=../ki/data/ki.db

# Toss
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_ALLOW_ORDERS=false
TOSS_REAL_TRADING_ACK=
TOSS_MAX_ORDER_AMOUNT_USD=500
TOSS_MAX_ORDER_AMOUNT_KRW=500000
TOSS_MAX_SLIPPAGE_PCT=0.10
TOSS_TIMEOUT_SECONDS=10
TOSS_DB_PATH=../toss/data/toss.db
# 조회 보고 워커의 영속 디렉터리 (미설정 시 core/data/manager)
# AI_MANAGER_DATA_DIR=/srv/ai-manager/shared/core/data/manager

# Optional APNs provider credentials. Keep the .p8 file outside Git.
AI_MANAGER_APNS_TEAM_ID=
AI_MANAGER_APNS_KEY_ID=
AI_MANAGER_APNS_KEY_PATH=/run/ai-manager-secrets/apns.p8
AI_MANAGER_APNS_TOPIC=com.example.ai-manager
# Enable only when the isolated planner service is configured.
AI_MANAGER_PLANNER_ENABLED=false
