# demo: 모의투자, real: 실전투자
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# 주문은 아래 값을 true로 바꾸고 CLI에 --execute를 함께 넣어야 전송됩니다.
KIS_ALLOW_ORDERS=false

# 실전투자는 아래 문구까지 정확히 설정해야 합니다.
KIS_REAL_TRADING_ACK=

# 한 번의 주문에 허용할 최대 추정 금액(원)
KIS_MAX_ORDER_AMOUNT=100000

# 해외주식 Gateway 후보 1회 주문 한도(USD)
KIS_MAX_OVERSEAS_ORDER_AMOUNT_USD=500
KIS_TIMEOUT_SECONDS=10

# 계좌 조회 스냅샷을 저장할 SQLite 경로
KI_DB_PATH=data/ki.db
